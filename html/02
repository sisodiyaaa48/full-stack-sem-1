<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Page Title</title>

    <!-- Essential Open Graph Tags -->
    <meta property="og:title" content="Your Catchy Article or Page Title" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://yourwebsite.com" />
    <meta property="og:image" content="https://yourwebsite.com" />
    
    <!-- Optional but Highly Recommended OG Tags -->
    <meta property="og:description" content="A brief, compelling summary of your page to entice people to click." />
    <meta property="og:site_name" content="Your Brand Name" />
    <meta property="og:locale" content="en_US" />
</head>
<body>
    <h1>Hello World</h1>
</body>
</html>